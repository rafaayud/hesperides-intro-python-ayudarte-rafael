# Local development only. Never commit your actual .env or API credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading

# Public market data and backtests do not require keys.
# Optional Spot Testnet credentials, only needed to start automated trading.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true
