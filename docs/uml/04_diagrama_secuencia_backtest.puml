@startuml
!theme plain
autonumber

actor "User" as User
participant "FastAPI" as API
participant "BacktestController" as Controller
participant "IngestionService" as Ingestion
participant "BacktestService" as Backtest
participant "StrategyFactory" as Factory
participant "BinanceExchangeAdapter" as Exchange
participant "PostgresStorageAdapter" as Storage
participant "Strategy" as Strategy
participant "BacktestResult" as Result

User -> API: POST /api/backtest
API -> Controller: backtest(request)

== Data Sync ==
Controller -> Ingestion: sync_all([symbol], [interval])
Ingestion -> Exchange: get_historical_candles(symbol, interval, limit)
Exchange -> Binance: GET /api/v3/klines
Binance --> Exchange: candles data
Exchange --> Ingestion: List[Candle_static]
Ingestion -> Storage: save_candles(candles)
Storage -> PostgreSQL: INSERT INTO candles
PostgreSQL --> Storage: saved
Storage --> Ingestion: done
Ingestion --> Controller: synced

== Backtest Execution ==
Controller -> Backtest: get_candles(symbol, interval)
Backtest -> Storage: get_candles(symbol, interval, limit)
Storage -> PostgreSQL: SELECT * FROM candles
PostgreSQL --> Storage: candles
Storage --> Backtest: List[Candle_static]

Controller -> Factory: create_strategy(strategy_name, params)
Factory --> Controller: Strategy instance

Controller -> Backtest: test_strategy(strategy, candles, capital)

loop For each candle
    Backtest -> Strategy: generate_signal(window)
    Strategy --> Backtest: Signal
    
    alt Signal == BUY and no position
        Backtest -> Backtest: create Position
        Backtest -> Backtest: update capital
    else Signal == SELL and has position
        Backtest -> Backtest: close Position
        Backtest -> Backtest: create Trade
        Backtest -> Backtest: update capital
    end
end

Backtest -> Result: BacktestResult(...)
Result --> Backtest: result
Backtest -> Result: to_dict()
Result --> Backtest: dict
Backtest --> Controller: result_dict

Controller -> Controller: add candles to response
Controller --> API: response
API --> User: 200 OK with results

note right of Backtest
  Calculates:
  - Total trades
  - Winners/Losers
  - Win rate
  - Total PnL
  - Final capital
end note

@enduml

