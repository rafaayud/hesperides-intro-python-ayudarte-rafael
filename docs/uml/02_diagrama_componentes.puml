@startuml
!theme plain
skinparam componentStyle rectangle

package "Trading System Architecture" {
    
    ' ============ APPLICATION LAYER ============
    package "Application Services" {
        component [TradingEngine] as TradingEngine
        component [PortfolioManager] as PortfolioManager
        component [BacktestService] as BacktestService
        component [IngestionService] as IngestionService
        component [StrategyFactory] as StrategyFactory
    }
    
    ' ============ DOMAIN LAYER ============
    package "Domain" {
        component [Portfolio] as PortfolioAgg
        component [Trader] as TraderAgg
        component [CandleBuffer] as CandleBufferAgg
        component [Strategies] as Strategies
        component [Ports] as Ports
    }
    
    ' ============ INFRASTRUCTURE LAYER ============
    package "Infrastructure Adapters" {
        component [BinanceExchangeAdapter] as BinanceExchange
        component [BinanceStreamAdapter] as BinanceStream
        component [BinanceOrderAdapter] as BinanceOrder
        component [PostgresStorageAdapter] as PostgresStorage
        component [PostgresPortfolioAdapter] as PostgresPortfolio
    }
    
    ' ============ API LAYER ============
    package "API Layer" {
        component [FastAPI] as FastAPI
        component [BacktestController] as BacktestController
        component [PortfolioController] as PortfolioController
        component [TradingController] as TradingController
    }
    
    ' ============ EXTERNAL SYSTEMS ============
    package "External Systems" {
        database "PostgreSQL" as PostgreSQL
        cloud "Binance Exchange" as Binance
    }
}

' ============ APPLICATION -> DOMAIN ============
TradingEngine --> PortfolioAgg : uses
TradingEngine --> TraderAgg : uses
TradingEngine --> CandleBufferAgg : uses
TradingEngine --> Strategies : uses
PortfolioManager --> PortfolioAgg : manages
BacktestService --> Strategies : uses
StrategyFactory --> Strategies : creates

' ============ APPLICATION -> PORTS ============
TradingEngine --> Ports : depends on
PortfolioManager --> Ports : depends on
BacktestService --> Ports : depends on
IngestionService --> Ports : depends on

' ============ INFRASTRUCTURE -> PORTS ============
BinanceExchange ..|> Ports : implements ExchangePort
BinanceStream ..|> Ports : implements StreamPort
BinanceOrder ..|> Ports : implements OrderPort
PostgresStorage ..|> Ports : implements StoragePort
PostgresPortfolio ..|> Ports : implements PortfolioStoragePort

' ============ APPLICATION -> INFRASTRUCTURE ============
TradingEngine --> BinanceStream : uses
TradingEngine --> BinanceOrder : uses
PortfolioManager --> PostgresPortfolio : uses
BacktestService --> PostgresStorage : uses
IngestionService --> BinanceExchange : uses
IngestionService --> PostgresStorage : uses

' ============ INFRASTRUCTURE -> EXTERNAL ============
BinanceExchange --> Binance : REST API
BinanceStream --> Binance : WebSocket
BinanceOrder --> Binance : REST API
PostgresStorage --> PostgreSQL : SQL
PostgresPortfolio --> PostgreSQL : SQL

' ============ API -> APPLICATION ============
FastAPI --> BacktestController
FastAPI --> PortfolioController
FastAPI --> TradingController
BacktestController --> BacktestService
BacktestController --> IngestionService
BacktestController --> StrategyFactory
PortfolioController --> PortfolioManager
PortfolioController --> StrategyFactory
TradingController --> TradingEngine
TradingController --> PortfolioManager

note right of TradingEngine
  Orchestrates real-time trading
  with 3-queue pipeline:
  1. Candle Queue
  2. Order Queue
  3. Response Queue
end note

note right of PortfolioAgg
  Aggregate Root
  Manages capital, positions,
  and trades for multiple traders
end note

note right of Ports
  Hexagonal Architecture
  Ports define interfaces
  Adapters implement them
end note

@enduml

